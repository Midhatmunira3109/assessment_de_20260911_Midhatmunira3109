# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Pipeline target DB (same container, separate schema)
PIPELINE_DB_HOST=postgres
PIPELINE_DB_PORT=5432
PIPELINE_DB_NAME=weather
PIPELINE_DB_USER=weather_user
PIPELINE_DB_PASSWORD=weather_pass

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_YOUR_FERNET_KEY
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=supersecretkey
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ── JupyterLab ────────────────────────────────────────────────────────────────
JUPYTER_TOKEN=easy
